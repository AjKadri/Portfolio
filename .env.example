# Required. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional server settings
OPENROUTER_MODEL=openai/gpt-4.1-mini
SITE_URL=http://localhost:3000
PORT=3000

# Contact form (https://resend.com — sign up with the inbox you want enquiries in)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional; default works without verifying a domain
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
